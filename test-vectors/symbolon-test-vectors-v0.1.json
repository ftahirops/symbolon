{
  "$schema_note": "Test vectors for Symbolon Protocol v1 verification. Vectors marked level='MUST' are required for conformance per spec §11.3. Vectors marked level='SHOULD' are recommended. Signature/key fields in this draft are PLACEHOLDERS — real Ed25519 fixtures will land alongside the Go reference verifier and replace the 'PLACEHOLDER_*' tokens. Until then, signature-checking vectors (V-002, V-008, V-009) cannot be exercised end-to-end; the other vectors validate parsing, time, replay, and binding logic that does not require a live signature.",
  "version": "0.1",
  "spec": "symbolon-protocol-v0.1.md",
  "shared": {
    "vault_id": "vault:01JBYZK000VAULTKEYDEMO0001",
    "vault_pubkey_multibase": "PLACEHOLDER_VAULT_PUBKEY_ED25519_MB58BTC",
    "subject_id": "usr_01JBYZK000SUBJECTDEMO00001",
    "app_id": "test.symbolon.app",
    "device_id": "dev_01JBYZK000DEVICEDEMO000001",
    "ephemeral_pubkey": "PLACEHOLDER_EPHEMERAL_PUBKEY_MB58BTC",
    "ephemeral_privkey_for_test_only": "PLACEHOLDER_EPHEMERAL_PRIVKEY_MB58BTC",
    "verifier_config": {
      "app_id": "test.symbolon.app",
      "clock_skew_sec": 5,
      "now": "2026-06-04T19:05:00Z"
    }
  },
  "vectors": [
    {
      "id": "V-001",
      "name": "happy-path well-formed lease (parse + bindings only)",
      "level": "MUST",
      "exercises": ["§3 schema", "§4 steps 1-3, 7, 11"],
      "lease": {
        "v": 1,
        "type": "symbolon.lease",
        "jti": "01JBYZK7HAPPYPATHTEST00001",
        "vault_id": "vault:01JBYZK000VAULTKEYDEMO0001",
        "subject_id": "usr_01JBYZK000SUBJECTDEMO00001",
        "app_id": "test.symbolon.app",
        "device_id": "dev_01JBYZK000DEVICEDEMO000001",
        "not_before": "2026-06-04T19:00:00Z",
        "not_after":  "2026-06-04T19:10:00Z",
        "max_session_ttl_sec": 1800,
        "allowed_actions": ["login", "read"],
        "ephemeral_pubkey": "PLACEHOLDER_EPHEMERAL_PUBKEY_MB58BTC",
        "nonce_challenge_required": true,
        "vault_signature": "PLACEHOLDER_VALID_SIGNATURE"
      },
      "request": {
        "device_id": "dev_01JBYZK000DEVICEDEMO000001"
      },
      "expect": "accept (signature verification skipped pending real fixtures)"
    },
    {
      "id": "V-002",
      "name": "tampered field invalidates signature",
      "level": "MUST",
      "exercises": ["§4 step 6", "§3.4 JCS+Ed25519"],
      "lease_base": "V-001",
      "mutation": {
        "subject_id": "usr_01JBYZK000ATTACKER00000001"
      },
      "expect_error": "signature_invalid (1200)"
    },
    {
      "id": "V-003",
      "name": "expired lease",
      "level": "MUST",
      "exercises": ["§4 step 8"],
      "lease_base": "V-001",
      "mutation": {
        "not_before": "2026-06-04T18:00:00Z",
        "not_after":  "2026-06-04T18:10:00Z"
      },
      "expect_error": "lease_expired (1300)"
    },
    {
      "id": "V-004",
      "name": "not yet valid",
      "level": "MUST",
      "exercises": ["§4 step 8"],
      "lease_base": "V-001",
      "mutation": {
        "not_before": "2026-06-04T20:00:00Z",
        "not_after":  "2026-06-04T20:10:00Z"
      },
      "expect_error": "lease_not_yet_valid (1301)"
    },
    {
      "id": "V-005",
      "name": "wrong app",
      "level": "MUST",
      "exercises": ["§4 step 7"],
      "lease_base": "V-001",
      "mutation": {
        "app_id": "other.symbolon.app"
      },
      "expect_error": "app_mismatch (1500)"
    },
    {
      "id": "V-006",
      "name": "wrong device",
      "level": "MUST",
      "exercises": ["§4 step 11"],
      "lease_base": "V-001",
      "request": {
        "device_id": "dev_01JBYZK000ATTACKER00000001"
      },
      "expect_error": "device_mismatch (1501)"
    },
    {
      "id": "V-007",
      "name": "replay — second use of same JTI fails",
      "level": "MUST",
      "exercises": ["§4 step 9", "§4.1 atomicity"],
      "lease_base": "V-001",
      "sequence": [
        {"step": 1, "action": "verify",       "expect": "accept"},
        {"step": 2, "action": "verify_again", "expect_error": "lease_replayed (1400)"}
      ]
    },
    {
      "id": "V-008",
      "name": "challenge required, valid signature with ephemeral key",
      "level": "MUST",
      "exercises": ["§4 step 12"],
      "lease_base": "V-001",
      "challenge": "PLACEHOLDER_32_BYTE_CHALLENGE",
      "client_signature": "PLACEHOLDER_VALID_EPHEMERAL_SIG",
      "expect": "accept"
    },
    {
      "id": "V-009",
      "name": "challenge required, wrong signature",
      "level": "MUST",
      "exercises": ["§4 step 12"],
      "lease_base": "V-001",
      "challenge": "PLACEHOLDER_32_BYTE_CHALLENGE",
      "client_signature": "PLACEHOLDER_INVALID_EPHEMERAL_SIG",
      "expect_error": "challenge_failed (1600)"
    },
    {
      "id": "V-010",
      "name": "unknown vault",
      "level": "MUST",
      "exercises": ["§4 step 4"],
      "lease_base": "V-001",
      "mutation": {
        "vault_id": "vault:01JBYZK000UNKNOWNVAULT0001"
      },
      "expect_error": "vault_unknown (1100)"
    },
    {
      "id": "V-011",
      "name": "version unsupported",
      "level": "MUST",
      "exercises": ["§4 step 2"],
      "lease_base": "V-001",
      "mutation": {
        "v": 99
      },
      "expect_error": "lease_version_unsupported (1002)"
    },
    {
      "id": "V-012",
      "name": "type discriminator wrong",
      "level": "MUST",
      "exercises": ["§4 step 3"],
      "lease_base": "V-001",
      "mutation": {
        "type": "vaultgate.lease"
      },
      "expect_error": "lease_type_invalid (1003)"
    },
    {
      "id": "V-013",
      "name": "geo constraint — country mismatch",
      "level": "SHOULD",
      "exercises": ["§3.3", "§4 step 10"],
      "lease_base": "V-001",
      "mutation": {
        "geo_constraint": {"countries": ["NL"]}
      },
      "request": {
        "device_id": "dev_01JBYZK000DEVICEDEMO000001",
        "origin": {"country": "RU", "asn": 1234, "ip": "203.0.113.5"}
      },
      "expect_error": "geo_constraint_failed (1502)"
    },
    {
      "id": "V-014",
      "name": "geo constraint — country match, ASN constraint also satisfied",
      "level": "SHOULD",
      "exercises": ["§3.3", "§4 step 10"],
      "lease_base": "V-001",
      "mutation": {
        "geo_constraint": {"countries": ["NL"], "asns": [1136, 33915]}
      },
      "request": {
        "device_id": "dev_01JBYZK000DEVICEDEMO000001",
        "origin": {"country": "NL", "asn": 1136, "ip": "84.85.86.87"}
      },
      "expect": "accept"
    },
    {
      "id": "V-015",
      "name": "clock untrusted — verifier MUST fail closed",
      "level": "MUST",
      "exercises": ["§4.2", "§9.3"],
      "lease_base": "V-001",
      "verifier_state": {"clock_trusted": false},
      "expect_error": "clock_untrusted (1302)"
    },
    {
      "id": "V-016",
      "name": "lease lifetime > 1h — SHOULD reject",
      "level": "SHOULD",
      "exercises": ["§9.5"],
      "lease_base": "V-001",
      "mutation": {
        "not_before": "2026-06-04T19:00:00Z",
        "not_after":  "2026-06-04T21:00:00Z"
      },
      "expect_error": "lease_expired-or-policy (implementation choice; spec §9.5 SHOULD)"
    }
  ]
